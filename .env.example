# Kora Pay — Environment Variables
# Copy this to .env and fill in your values before deploying

# The base58-encoded private key of the fee-payer wallet (HeaqgYh7oC4n7VWEmgkxSVmHM4NL8B6qBowBpRSE8itW)
KORA_PRIVATE_KEY=

# Helius API key (from helius.dev dashboard)
HELIUS_API_KEY=

# Full Solana RPC URL — built from the Helius key above
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Port for the Kora server (default: 3000)
PORT=3000
